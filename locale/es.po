msgid "autoritário"
msgstr "autoritario"

#: scripts/sim/dialogue.gd:63
msgid "libertário"
msgstr "libertario"

#: scripts/sim/dialogue.gd:63 scripts/sim/law_catalog.gd_(escolha_dr_level)
msgid "moderado"
msgstr "moderado"

#: scripts/sim/dialogue.gd:86
#, c-format
msgid "%s e %s se reúnem e assinam tratado de {tipo}."
msgstr "%s y %s se reúnen y firman un tratado de {tipo}."

#: scripts/sim/dialogue.gd:89
#, c-format
msgid "Encontro de %s e %s termina em atrito."
msgstr "El encuentro de %s y %s termina en roce."

#: scripts/sim/dialogue.gd:91
#, c-format
msgid "%s e %s se reúnem para aproximar os governos."
msgstr "%s y %s se reúnen para acercar a sus gobiernos."

#: scripts/sim/dialogue.gd:96
msgid "Seja direto. Não tenho muito tempo para o seu governo."
msgstr "Sea directo. No tengo mucho tiempo para su gobierno."

#: scripts/sim/dialogue.gd:98
msgid "Enquanto houver tropas na fronteira, esta conversa será curta."
msgstr "Mientras haya tropas en la frontera, esta conversación será corta."

#: scripts/sim/dialogue.gd:100
msgid "É sempre um prazer falar com um velho amigo. Em que posso ajudar?"
msgstr "Siempre es un placer hablar con un viejo amigo. ¿En qué puedo ayudar?"

#: scripts/sim/dialogue.gd:102
msgid "Bom falar com você. Nossos países têm muito a ganhar juntos."
msgstr "Bueno hablar contigo. Nuestros países tienen mucho que ganar juntos."

#: scripts/sim/dialogue.gd:104
msgid "Recebi o seu pedido de conversa. O que deseja discutir?"
msgstr "Recibí su pedido de conversación. ¿Qué desea tratar?"

#: scripts/sim/dialogue.gd:107
msgid " Vejo que o seu partido pensa como eu."
msgstr " Veo que su partido piensa como yo."

#: scripts/sim/dialogue.gd:109
msgid " Sabemos que o seu partido e eu pensamos muito diferente."
msgstr " Sabemos que su partido y yo pensamos muy distinto."

#: scripts/sim/dialogue.gd:120
msgid "Proponho encerrarmos esta guerra."
msgstr "Propongo que pongamos fin a esta guerra."

#: scripts/sim/dialogue.gd:120
msgid "A frente e o cansaço decidem."
msgstr "El frente y el cansancio deciden."

#: scripts/sim/dialogue.gd:121
msgid "Sua agressão será lembrada."
msgstr "Su agresión será recordada."

#: scripts/sim/dialogue.gd:121 scripts/sim/dialogue.gd:140
msgid "Relação cai, e sua aprovação sobe um pouco."
msgstr "La relación cae, y tu aprobación sube un poco."

#: scripts/sim/dialogue.gd:123
msgid "Quero elogiar a parceria entre nossos países."
msgstr "Quiero elogiar la alianza entre nuestros países."

#: scripts/sim/dialogue.gd:123
msgid "Melhora a relação, mais ainda com ideias parecidas."
msgstr "Mejora la relación, aún más con ideas parecidas."

#: scripts/sim/dialogue.gd:125
msgid "Vamos abrir nossos mercados um ao outro?"
msgstr "¿Abrimos nuestros mercados el uno al otro?"

#: scripts/sim/dialogue.gd:125
msgid "Acordo de livre comércio, se houver confiança."
msgstr "Acuerdo de libre comercio, si hay confianza."

#: scripts/sim/dialogue.gd:127
msgid "Proponho um pacto de defesa mútua."
msgstr "Propongo un pacto de defensa mutua."

#: scripts/sim/dialogue.gd:127
msgid "Precisa de muita confiança."
msgstr "Necesita mucha confianza."

#: scripts/sim/dialogue.gd:128
msgid "Meu governo quer enviar ajuda ao seu povo."
msgstr "Mi gobierno quiere enviar ayuda a su pueblo."

#: scripts/sim/dialogue.gd:128
msgid "Doa 0,1% do seu PIB."
msgstr "Dona el 0,1% de tu PIB."

#: scripts/sim/dialogue.gd:134
#, c-format
msgid "Proponho um tratado de %s."
msgstr "Propongo un tratado de %s."

#: scripts/sim/dialogue.gd:136
msgid "Seu governo precisa respeitar os direitos do seu povo."
msgstr "Su gobierno debe respetar los derechos de su pueblo."

#: scripts/sim/dialogue.gd:136
msgid "Agrada seu eleitor. Líderes autoritários não gostam nada disso."
msgstr "Agrada a tus votantes. A los líderes autoritarios no les gusta nada."

#: scripts/sim/dialogue.gd:139
#, c-format
msgid "Peço que você sancione %s."
msgstr "Le pido que sancione a %s."

#: scripts/sim/dialogue.gd:139
msgid "Só um aliado próximo aceitaria."
msgstr "Solo un aliado cercano aceptaría."

#: scripts/sim/dialogue.gd:140
msgid "Preciso protestar contra as ações do seu governo."
msgstr "Debo protestar contra las acciones de su gobierno."

#: scripts/sim/dialogue.gd:141
msgid "Mude de postura ou haverá consequências."
msgstr "Cambie de postura o habrá consecuencias."

#: scripts/sim/dialogue.gd:141
msgid "Funciona com quem é bem mais fraco que você."
msgstr "Funciona con quien es mucho más débil que tú."

#: scripts/sim/dialogue.gd:169
msgid "Elogios não mudam o que pensamos, mas agradeço a cortesia."
msgstr "Los elogios no cambian lo que pensamos, pero agradezco la cortesía."

#: scripts/sim/dialogue.gd:170
msgid "Palavras gentis, e bem-vindas. Vou lembrar disso."
msgstr "Palabras amables, y bienvenidas. Lo recordaré."

#: scripts/sim/dialogue.gd:174
msgid "Abrir assim destruiria empregos aqui. Não é o que defendo."
msgstr "Abrir así destruiría empleos aquí. No es lo que defiendo."

#: scripts/sim/dialogue.gd:174
msgid "Meu parlamento não aceitaria. Ainda falta confiança entre nós."
msgstr "Mi parlamento no lo aceptaría. Aún falta confianza entre nosotros."

#: scripts/sim/dialogue.gd:176
msgid "Temos um acordo. Assinamos agora, e cada parlamento ratifica depois."
msgstr "Tenemos un acuerdo. Firmamos ahora, y cada parlamento ratifica después."

#: scripts/sim/dialogue.gd:180
msgid "Um pacto assim exige mais do que temos hoje. Sigamos conversando."
msgstr "Un pacto así exige más de lo que tenemos hoy. Sigamos conversando."

#: scripts/sim/dialogue.gd:182
msgid "Então está decidido: assinamos, e um ataque a um será um ataque ao outro assim que os parlamentos ratificarem."
msgstr "Entonces está decidido: firmamos, y un ataque a uno será un ataque al otro en cuanto los parlamentos ratifiquen."

#: scripts/sim/dialogue.gd:186
msgid "Agradeço a intenção, mas seu governo não tem como cumprir isso agora."
msgstr "Agradezco la intención, pero su gobierno no puede cumplir eso ahora."

#: scripts/sim/dialogue.gd:188
msgid "Aceito, embora eu prefira comércio a caridade."
msgstr "Acepto, aunque prefiero el comercio a la caridad."

#: scripts/sim/dialogue.gd:189
msgid "Meu povo agradece. Não vamos esquecer esse gesto."
msgstr "Mi pueblo se lo agradece. No olvidaremos este gesto."

#: scripts/sim/dialogue.gd:193
msgid "Não vou comprar essa briga por você."
msgstr "No voy a pelear esa batalla por usted."

#: scripts/sim/dialogue.gd:195
#, c-format
msgid "%s impõe sanções a %s a pedido de %s."
msgstr "%s impone sanciones a %s a pedido de %s."

#: scripts/sim/dialogue.gd:196
msgid "Conte com isso. As sanções saem ainda hoje."
msgstr "Cuente con ello. Las sanciones salen hoy mismo."

#: scripts/sim/dialogue.gd:200
msgid "Meu país não aceita lições. Cuide do seu povo, que eu cuido do meu."
msgstr "Mi país no acepta lecciones. Cuide de su pueblo, que yo cuido del mío."

#: scripts/sim/dialogue.gd:204
msgid "Registrado. Não espere que eu mude por causa disso."
msgstr "Anotado. No espere que cambie por eso."

#: scripts/sim/dialogue.gd:210
msgid "Entendi o recado. Vamos rever nossa posição, por enquanto."
msgstr "Entendí el mensaje. Revisaremos nuestra posición, por ahora."

#: scripts/sim/dialogue.gd:212
msgid "Você não está em condições de me ameaçar. Isso terá um preço."
msgstr "No está en condiciones de amenazarme. Esto tendrá un precio."

#: scripts/sim/dialogue.gd:215
msgid "Sem uma proposta concreta, não há o que discutir."
msgstr "Sin una propuesta concreta, no hay nada que discutir."

#: scripts/sim/dialogue.gd:218
msgid "Não. Esta guerra só acaba nos meus termos."
msgstr "No. Esta guerra solo termina en mis términos."

#: scripts/sim/dialogue.gd:219
msgid "Basta de sangue. Vamos aos termos."
msgstr "Basta de sangre. Vamos a los términos."

#: scripts/sim/dialogue.gd:220
msgid "Não entendi o que você quis dizer."
msgstr "No entendí lo que quiso decir."

#: scripts/sim/dialogue.gd:226
msgid "Aceito. Assinamos, e cada parlamento ratifica."
msgstr "Acepto. Firmamos, y cada parlamento ratifica."

#: scripts/sim/dialogue.gd:227
msgid "Isso não combina com o que eu defendo, ou ainda não confio o bastante."
msgstr "Eso no encaja con lo que defiendo, o aún no confío lo suficiente."

#: scripts/sim/diplomacy.gd:344
#, c-format
msgid "%s retalia com tarifa de %d%% contra %s."
msgstr "%s toma represalias con un arancel del %d%% contra %s."

#: scripts/sim/diplomacy.gd:356
#, c-format
msgid "%s e %s assinam pacto de defesa mútua."
msgstr "%s y %s firman un pacto de defensa mutua."

