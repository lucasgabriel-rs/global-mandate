msgstr "La prensa revela sobornos en contratos de infraestructura que involucran a ministros de tu gobierno."

#: scripts/sim/events.gd:180
msgid "Demitir e abrir investigação independente"
msgstr "Destituir y abrir una investigación independiente"

#: scripts/sim/events.gd:180
msgid "Aprovação cai pouco agora; instituições ganham"
msgstr "La aprobación cae poco ahora; las instituciones ganan"

#: scripts/sim/events.gd:184
