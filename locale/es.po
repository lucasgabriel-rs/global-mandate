msgstr "Mixta"

#: scripts/sim/dialogue.gd:24 scripts/sim/world.gd:825
msgid "Na oposição, você não fala em nome do país."
msgstr "En la oposición, no hablas en nombre del país."

#: scripts/sim/dialogue.gd:26
msgid "Não há com quem conversar."
msgstr "No hay con quién conversar."

#: scripts/sim/dialogue.gd:28
msgid "Vocês conversaram há pouco. Tente no mês que vem."
msgstr "Hablaron hace poco. Inténtalo el mes que viene."

#: scripts/sim/dialogue.gd:62
msgid "esquerda"
msgstr "izquierda"

#: scripts/sim/dialogue.gd:62
msgid "direita"
msgstr "derecha"

#: scripts/sim/dialogue.gd:62
msgid "centro"
msgstr "centro"

