#: scripts/sim/dialogue.gd:26
msgid "Não há com quem conversar."
msgstr "There is no one to talk to."

#: scripts/sim/dialogue.gd:28
msgid "Vocês conversaram há pouco. Tente no mês que vem."
msgstr "You talked recently. Try again next month."

#: scripts/sim/dialogue.gd:48 scripts/sim/dialogue.gd:245
#: scripts/sim/party_talk.gd:84 scripts/sim/party_talk.gd:95
msgid "Não entendi o que você quis dizer."
msgstr "I didn't understand what you meant."

#: scripts/sim/dialogue.gd:87
msgid "esquerda"
msgstr "left"

#: scripts/sim/dialogue.gd:87
msgid "direita"
msgstr "right"

#: scripts/sim/dialogue.gd:87
msgid "centro"
msgstr "center"

#: scripts/sim/dialogue.gd:88
msgid "autoritário"
msgstr "authoritarian"

#: scripts/sim/dialogue.gd:88
msgid "libertário"
msgstr "libertarian"

#: scripts/sim/dialogue.gd:88 scripts/sim/law_catalog.gd_(escolha_dr_level)
msgid "moderado"
msgstr "moderate"

#: scripts/sim/dialogue.gd:111
#, c-format
msgid "%s e %s se reúnem e assinam tratado de {tipo}."
msgstr "%s and %s meet and sign a {tipo} treaty."

#: scripts/sim/dialogue.gd:114
#, c-format
msgid "Encontro de %s e %s termina em atrito."
msgstr "Meeting between %s and %s ends in friction."

#: scripts/sim/dialogue.gd:116
#, c-format
msgid "%s e %s se reúnem para aproximar os governos."
msgstr "%s and %s meet to bring their governments closer."

#: scripts/sim/dialogue.gd:121
msgid "Seja direto. Não tenho muito tempo para o seu governo."
msgstr "Be direct. I don't have much time for your government."

#: scripts/sim/dialogue.gd:123
msgid "Enquanto houver tropas na fronteira, esta conversa será curta."
msgstr "As long as there are troops on the border, this conversation will be short."

#: scripts/sim/dialogue.gd:125
msgid "É sempre um prazer falar com um velho amigo. Em que posso ajudar?"
msgstr "It's always a pleasure to speak with an old friend. How can I help?"

#: scripts/sim/dialogue.gd:127
msgid "Bom falar com você. Nossos países têm muito a ganhar juntos."
msgstr "Good to talk to you. Our countries have much to gain together."

#: scripts/sim/dialogue.gd:129
msgid "Recebi o seu pedido de conversa. O que deseja discutir?"
msgstr "I received your request to talk. What would you like to discuss?"

#: scripts/sim/dialogue.gd:132
msgid " Vejo que o seu partido pensa como eu."
msgstr " I see your party thinks like I do."

#: scripts/sim/dialogue.gd:134
msgid " Sabemos que o seu partido e eu pensamos muito diferente."
msgstr " We know your party and I think very differently."

#: scripts/sim/dialogue.gd:145
msgid "Proponho encerrarmos esta guerra."
msgstr "I propose we end this war."

#: scripts/sim/dialogue.gd:145
msgid "A frente e o cansaço decidem."
msgstr "The front and war weariness decide."

#: scripts/sim/dialogue.gd:146
msgid "Sua agressão será lembrada."
msgstr "Your aggression will be remembered."

#: scripts/sim/dialogue.gd:146 scripts/sim/dialogue.gd:165
msgid "Relação cai, e sua aprovação sobe um pouco."
msgstr "Relations drop, and your approval rises a little."

#: scripts/sim/dialogue.gd:148
msgid "Quero elogiar a parceria entre nossos países."
msgstr "I want to praise the partnership between our countries."

#: scripts/sim/dialogue.gd:148
msgid "Melhora a relação, mais ainda com ideias parecidas."
msgstr "Improves relations, even more with similar ideas."

#: scripts/sim/dialogue.gd:150
msgid "Vamos abrir nossos mercados um ao outro?"
msgstr "Shall we open our markets to each other?"

#: scripts/sim/dialogue.gd:150
msgid "Acordo de livre comércio, se houver confiança."
msgstr "Free trade agreement, if there is trust."

#: scripts/sim/dialogue.gd:152
msgid "Proponho um pacto de defesa mútua."
msgstr "I propose a mutual defense pact."

#: scripts/sim/dialogue.gd:152
msgid "Precisa de muita confiança."
msgstr "Requires a lot of trust."

#: scripts/sim/dialogue.gd:153
msgid "Meu governo quer enviar ajuda ao seu povo."
msgstr "My government wants to send aid to your people."

#: scripts/sim/dialogue.gd:153
msgid "Doa 0,1% do seu PIB."
msgstr "Donates 0.1% of your GDP."

#: scripts/sim/dialogue.gd:159
#, c-format
msgid "Proponho um tratado de %s."
msgstr "I propose a %s treaty."

#: scripts/sim/dialogue.gd:161
msgid "Seu governo precisa respeitar os direitos do seu povo."
msgstr "Your government must respect the rights of its people."

#: scripts/sim/dialogue.gd:161
msgid "Agrada seu eleitor. Líderes autoritários não gostam nada disso."
msgstr "Pleases your voters. Authoritarian leaders hate it."

#: scripts/sim/dialogue.gd:164
#, c-format
msgid "Peço que você sancione %s."
msgstr "I ask you to sanction %s."

#: scripts/sim/dialogue.gd:164
msgid "Só um aliado próximo aceitaria."
msgstr "Only a close ally would accept."

#: scripts/sim/dialogue.gd:165
msgid "Preciso protestar contra as ações do seu governo."
msgstr "I must protest your government's actions."

#: scripts/sim/dialogue.gd:166
msgid "Mude de postura ou haverá consequências."
msgstr "Change course or there will be consequences."

#: scripts/sim/dialogue.gd:166
msgid "Funciona com quem é bem mais fraco que você."
msgstr "Works on those much weaker than you."

#: scripts/sim/dialogue.gd:194
msgid "Elogios não mudam o que pensamos, mas agradeço a cortesia."
msgstr "Praise doesn't change what we think, but I appreciate the courtesy."

#: scripts/sim/dialogue.gd:195
msgid "Palavras gentis, e bem-vindas. Vou lembrar disso."
msgstr "Kind words, and welcome ones. I'll remember this."

#: scripts/sim/dialogue.gd:199
msgid "Abrir assim destruiria empregos aqui. Não é o que defendo."
msgstr "Opening up like that would destroy jobs here. It's not what I stand for."

#: scripts/sim/dialogue.gd:199
msgid "Meu parlamento não aceitaria. Ainda falta confiança entre nós."
msgstr "My parliament wouldn't accept. We still lack trust between us."

#: scripts/sim/dialogue.gd:201
msgid "Temos um acordo. Assinamos agora, e cada parlamento ratifica depois."
msgstr "We have a deal. We sign now, and each parliament ratifies later."

#: scripts/sim/dialogue.gd:205
msgid "Um pacto assim exige mais do que temos hoje. Sigamos conversando."
msgstr "A pact like this demands more than we have today. Let's keep talking."

#: scripts/sim/dialogue.gd:207
msgid "Então está decidido: assinamos, e um ataque a um será um ataque ao outro assim que os parlamentos ratificarem."
msgstr "Then it's settled: we sign, and an attack on one will be an attack on the other once the parliaments ratify."

#: scripts/sim/dialogue.gd:211
msgid "Agradeço a intenção, mas seu governo não tem como cumprir isso agora."
msgstr "I appreciate the intent, but your government can't deliver that now."

#: scripts/sim/dialogue.gd:213
msgid "Aceito, embora eu prefira comércio a caridade."
msgstr "I accept, although I prefer trade to charity."

#: scripts/sim/dialogue.gd:214
msgid "Meu povo agradece. Não vamos esquecer esse gesto."
msgstr "My people thank you. We won't forget this gesture."

#: scripts/sim/dialogue.gd:218
msgid "Não vou comprar essa briga por você."
msgstr "I won't pick that fight for you."

#: scripts/sim/dialogue.gd:220
#, c-format
msgid "%s impõe sanções a %s a pedido de %s."
msgstr "%s imposes sanctions on %s at the request of %s."

#: scripts/sim/dialogue.gd:221
msgid "Conte com isso. As sanções saem ainda hoje."
msgstr "Count on it. The sanctions go out today."

#: scripts/sim/dialogue.gd:225
msgid "Meu país não aceita lições. Cuide do seu povo, que eu cuido do meu."
msgstr "My country takes no lessons. Look after your people, and I'll look after mine."

#: scripts/sim/dialogue.gd:229
msgid "Registrado. Não espere que eu mude por causa disso."
msgstr "Noted. Don't expect me to change because of it."

#: scripts/sim/dialogue.gd:235
msgid "Entendi o recado. Vamos rever nossa posição, por enquanto."
msgstr "Message received. We'll review our position, for now."

#: scripts/sim/dialogue.gd:237
msgid "Você não está em condições de me ameaçar. Isso terá um preço."
msgstr "You are in no position to threaten me. This will have a price."

#: scripts/sim/dialogue.gd:240
msgid "Sem uma proposta concreta, não há o que discutir."
msgstr "Without a concrete proposal, there is nothing to discuss."

#: scripts/sim/dialogue.gd:243
msgid "Não. Esta guerra só acaba nos meus termos."
msgstr "No. This war only ends on my terms."

#: scripts/sim/dialogue.gd:244
msgid "Basta de sangue. Vamos aos termos."
msgstr "Enough bloodshed. Let's get to the terms."

#: scripts/sim/dialogue.gd:251
msgid "Aceito. Assinamos, e cada parlamento ratifica."
msgstr "I accept. We sign, and each parliament ratifies."

#: scripts/sim/dialogue.gd:252
msgid "Isso não combina com o que eu defendo, ou ainda não confio o bastante."
msgstr "That doesn't match what I stand for, or I don't trust you enough yet."

