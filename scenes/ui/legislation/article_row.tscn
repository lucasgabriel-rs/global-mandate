[gd_scene format=3]

[ext_resource type="Theme" path="res://scenes/ui/theme.tres" id="e1"]

[node name="ArticleRow" type="HBoxContainer"]
theme_override_constants/separation = 3
theme = ExtResource("e1")

[node name="select" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Escolhe este dispositivo para alterar."
focus_mode = 0
mouse_default_cursor_shape = 2
theme_override_font_sizes/font_size = 12
text = ""
alignment = 0
clip_text = true

[node name="delete" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Excluir este dispositivo."
focus_mode = 0
mouse_default_cursor_shape = 2
theme_override_font_sizes/font_size = 12
text = "Excluir"
