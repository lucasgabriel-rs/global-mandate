[gd_scene format=3]

[ext_resource type="PackedScene" path="res://scenes/ui/legislation/poll_box.tscn" id="poll_box"]
[ext_resource type="Script" path="res://scripts/ui/amendment_editor.gd" id="e1"]
[ext_resource type="Theme" path="res://scenes/ui/theme.tres" id="e2"]

[sub_resource type="StyleBoxFlat" id="s1"]
content_margin_left = 16.0
content_margin_top = 16.0
content_margin_right = 16.0
content_margin_bottom = 16.0
bg_color = Color(0.05, 0.09, 0.12, 0.99)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.9490196, 0.7019608, 0.23921569, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[node name="AmendmentEditor" type="ColorRect"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.01, 0.03, 0.05, 0.62)
script = ExtResource("e1")
theme = ExtResource("e2")

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Panel" type="PanelContainer" parent="Center"]
