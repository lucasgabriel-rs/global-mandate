[gd_scene format=3]

[ext_resource type="Theme" path="res://scenes/ui/theme.tres" id="1_theme"]

[node name="StockRow" type="HBoxContainer"]
mouse_filter = 2
theme = ExtResource("1_theme")
theme_override_constants/separation = 6

[node name="stock_name" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 12
text = "Empresa"
text_overrun_behavior = 3

[node name="stock_detail" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.54509807, 0.63529414, 0.6862745, 1)
theme_override_font_sizes/font_size = 11
text = "US$ 0 bi"
horizontal_alignment = 2

[node name="stock_value" type="Label" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(58, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "+0,0%"
horizontal_alignment = 2
