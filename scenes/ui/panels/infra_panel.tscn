[gd_scene format=3]

[ext_resource type="Theme" path="res://scenes/ui/theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://scripts/ui/infra_panel.gd" id="2_script"]
[ext_resource type="PackedScene" path="res://scenes/ui/panels/infra_build.tscn" id="3_build"]

[node name="infra" type="VBoxContainer"]
size_flags_horizontal = 3
mouse_filter = 2
theme = ExtResource("1_theme")
theme_override_constants/separation = 6
script = ExtResource("2_script")

[node name="Title" type="Label" parent="."]
layout_mode = 2
theme_override_colors/font_color = Color(0.54509807, 0.63529414, 0.6862745, 1)
theme_override_font_sizes/font_size = 11
text = "PORTOS E AEROPORTOS"

[node name="Note" type="Label" parent="."]
custom_minimum_size = Vector2(60, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.54509807, 0.63529414, 0.6862745, 1)
theme_override_font_sizes/font_size = 12
text = "Portos acompanham o comércio exterior; aeroportos, o PIB e o turismo. Acima de 80% de uso, a logística piora: o comércio engasga e transporte e turismo perdem produtividade."
autowrap_mode = 3

[node name="Summary" type="GridContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 2
columns = 2

[node name="PortsLabel" type="Label" parent="Summary"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 13
text = "Portos"

[node name="port_sat" type="Label" parent="Summary"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "85% da capacidade"
horizontal_alignment = 2

[node name="AirportsLabel" type="Label" parent="Summary"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 13
text = "Aeroportos"

[node name="air_sat" type="Label" parent="Summary"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "66% da capacidade"
horizontal_alignment = 2

[node name="LogisticsLabel" type="Label" parent="Summary"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 13
text = "Logística"

[node name="logistics" type="Label" parent="Summary"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "neutra"
horizontal_alignment = 2

[node name="Actions" type="HBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="build_port" type="Button" parent="Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 28)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
mouse_default_cursor_shape = 2
theme_override_font_sizes/font_size = 12
text = "Construir porto"

[node name="build_air" type="Button" parent="Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 28)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
mouse_default_cursor_shape = 2
theme_override_font_sizes/font_size = 12
text = "Construir aeroporto"

[node name="feedback" type="Label" parent="."]
