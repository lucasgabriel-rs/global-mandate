[gd_scene format=3]

[ext_resource type="Theme" path="res://scenes/ui/theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://scripts/ui/economy_panel.gd" id="2_script"]
[ext_resource type="PackedScene" path="res://scenes/ui/panels/infra_panel.tscn" id="3_infra"]
[ext_resource type="PackedScene" path="res://scenes/ui/panels/companies_panel.tscn" id="4_companies"]
[ext_resource type="PackedScene" path="res://scenes/ui/panels/stock_panel.tscn" id="5_stock"]

[node name="economy" type="VBoxContainer"]
size_flags_horizontal = 3
mouse_filter = 2
theme = ExtResource("1_theme")
theme_override_constants/separation = 6
script = ExtResource("2_script")

[node name="sub_tabs" type="TabContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
current_tab = 0

[node name="Sectors" type="VBoxContainer" parent="sub_tabs"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6
metadata/_tab_index = 0
metadata/_tab_name = "Setores"

[node name="Sectors" type="Label" parent="sub_tabs/Sectors"]
layout_mode = 2
theme_override_colors/font_color = Color(0.54509807, 0.63529414, 0.6862745, 1)
theme_override_font_sizes/font_size = 11
text = "SETORES DA ECONOMIA"

[node name="Note" type="Label" parent="sub_tabs/Sectors"]
custom_minimum_size = Vector2(60, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.54509807, 0.63529414, 0.6862745, 1)
theme_override_font_sizes/font_size = 12
text = "Quanto cada atividade produz por ano e quanto cresceu em 12 meses. Construção sente o juro, mineração o preço das commodities, turismo a guerra e a instabilidade."
autowrap_mode = 3

[node name="sector_rows" type="VBoxContainer" parent="sub_tabs/Sectors"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Infrastructure" type="VBoxContainer" parent="sub_tabs"]
visible = false
layout_mode = 2
mouse_filter = 2
metadata/_tab_index = 1
metadata/_tab_name = "Infraestrutura"

[node name="infra" parent="sub_tabs/Infrastructure" instance=ExtResource("3_infra")]
unique_name_in_owner = true
layout_mode = 2

[node name="Companies" type="VBoxContainer" parent="sub_tabs"]
visible = false
layout_mode = 2
mouse_filter = 2
metadata/_tab_index = 2
metadata/_tab_name = "Empresas"

[node name="companies" parent="sub_tabs/Companies" instance=ExtResource("4_companies")]
unique_name_in_owner = true
layout_mode = 2

[node name="Stock" type="VBoxContainer" parent="sub_tabs"]
visible = false
layout_mode = 2
mouse_filter = 2
metadata/_tab_index = 3
metadata/_tab_name = "Bolsa"

[node name="stock" parent="sub_tabs/Stock" instance=ExtResource("5_stock")]
unique_name_in_owner = true
layout_mode = 2

[node name="Population" type="VBoxContainer" parent="sub_tabs"]
visible = false
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6
metadata/_tab_index = 4
metadata/_tab_name = "População"

[node name="Population" type="Label" parent="sub_tabs/Population"]
layout_mode = 2
theme_override_colors/font_color = Color(0.54509807, 0.63529414, 0.6862745, 1)
theme_override_font_sizes/font_size = 11
text = "ESTRUTURA ETÁRIA"

[node name="NotePop" type="Label" parent="sub_tabs/Population"]
custom_minimum_size = Vector2(60, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.54509807, 0.63529414, 0.6862745, 1)
theme_override_font_sizes/font_size = 12
text = "Menos gente em idade de trabalhar reduz a produção; mais idosos pesam nas aposentadorias. Renda, paz e estabilidade atraem migrantes."
autowrap_mode = 3

[node name="pop_total" type="Label" parent="sub_tabs/Population"]
unique_name_in_owner = true
layout_mode = 2

[node name="young" type="HBoxContainer" parent="sub_tabs/Population"]
layout_mode = 2
mouse_filter = 2

[node name="young_label" type="Label" parent="sub_tabs/Population/young"]
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
text = "Jovens (0-14)"

[node name="young_bar" type="ProgressBar" parent="sub_tabs/Population/young"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 14)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
max_value = 1.0
show_percentage = false

[node name="young_value" type="Label" parent="sub_tabs/Population/young"]
unique_name_in_owner = true
custom_minimum_size = Vector2(60, 0)
layout_mode = 2
horizontal_alignment = 2

[node name="adult" type="HBoxContainer" parent="sub_tabs/Population"]
layout_mode = 2
mouse_filter = 2

[node name="adult_label" type="Label" parent="sub_tabs/Population/adult"]
