[gd_scene format=3]

[ext_resource type="Theme" path="res://scenes/ui/theme.tres" id="1_theme"]
[ext_resource type="Script" path="res://scripts/ui/economy_panel.gd" id="2_script"]
[ext_resource type="PackedScene" path="res://scenes/ui/panels/infra_panel.tscn" id="3_infra"]
