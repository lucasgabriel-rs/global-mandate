[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/debt_panel.gd" id="1_panel"]
[ext_resource type="Script" path="res://scripts/ui/debt_chart.gd" id="2_chart"]

[node name="debt" type="VBoxContainer"]
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 6
script = ExtResource("1_panel")

[node name="Separator" type="ColorRect" parent="."]
custom_minimum_size = Vector2(0, 1)
layout_mode = 2
mouse_filter = 2
color = Color(0.15294118, 0.2509804, 0.30980393, 1)

[node name="DebtHeading" type="Label" parent="."]
layout_mode = 2
theme_override_colors/font_color = Color(0.54509807, 0.63529414, 0.6862745, 1)
theme_override_font_sizes/font_size = 11
text = "DÍVIDA E JUROS"

[node name="debt_curve" type="Control" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 110)
layout_mode = 2
tooltip_text = "Rendimento dos títulos do governo por prazo. A ponta longa segue o efeito Fisher: juro real mais inflação esperada, mais prêmio de prazo e de risco."
script = ExtResource("2_chart")
title = "Curva de juros (% ao ano)"
mode = "curve"

[node name="Maturity" type="HBoxContainer" parent="."]
layout_mode = 2
tooltip_text = "Tempo médio até o vencimento dos títulos. Com risco alto, o mercado só compra papéis curtos."
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Maturity"]
layout_mode = 2
theme_override_colors/font_color = Color(0.54509807, 0.63529414, 0.6862745, 1)
theme_override_font_sizes/font_size = 13
text = "Prazo médio"

[node name="Space" type="Control" parent="Maturity"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="debt_maturity_value" type="Label" parent="Maturity"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.85882354, 0.9019608, 0.9254902, 1)
theme_override_font_sizes/font_size = 13
text = "—"

[node name="Mix" type="HBoxContainer" parent="."]
layout_mode = 2
tooltip_text = "Prefixados travam o juro nominal; indexados pagam juro real mais a inflação; a dívida em dólar sobe quando a moeda cai."
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Mix"]
layout_mode = 2
theme_override_colors/font_color = Color(0.54509807, 0.63529414, 0.6862745, 1)
theme_override_font_sizes/font_size = 13
text = "Prefixada / inflação / dólar"

[node name="Space" type="Control" parent="Mix"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="debt_mix_value" type="Label" parent="Mix"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.85882354, 0.9019608, 0.9254902, 1)
theme_override_font_sizes/font_size = 13
text = "—"

[node name="RealRate" type="HBoxContainer" parent="."]
layout_mode = 2
tooltip_text = "Juro nominal de 10 anos menos a inflação esperada no período."
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="RealRate"]
layout_mode = 2
theme_override_colors/font_color = Color(0.54509807, 0.63529414, 0.6862745, 1)
theme_override_font_sizes/font_size = 13
text = "Juro real de 10 anos"

[node name="Space" type="Control" parent="RealRate"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="debt_real_value" type="Label" parent="RealRate"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.85882354, 0.9019608, 0.9254902, 1)
theme_override_font_sizes/font_size = 13
text = "—"

[node name="debt_maturities" type="Control" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 110)
layout_mode = 2
tooltip_text = "Quanto da dívida vence em cada um dos próximos anos e precisa ser rolado aos juros de mercado."
script = ExtResource("2_chart")
title = "Vencimentos por ano"
mode = "bars"

[node name="Rollover" type="HBoxContainer" parent="."]
layout_mode = 2
tooltip_text = "Dívida que vence no próximo ano e será refinanciada aos juros de hoje."
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Rollover"]
layout_mode = 2
theme_override_colors/font_color = Color(0.54509807, 0.63529414, 0.6862745, 1)
theme_override_font_sizes/font_size = 13
text = "Vencimentos em 12 meses"

[node name="Space" type="Control" parent="Rollover"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="debt_rollover_value" type="Label" parent="Rollover"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.85882354, 0.9019608, 0.9254902, 1)
theme_override_font_sizes/font_size = 13
text = "—"

[node name="Snowball" type="HBoxContainer" parent="."]
layout_mode = 2
tooltip_text = "Efeito bola de neve em 12 meses, (r − g)/(1 + g)·b, em pontos do PIB."
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Snowball"]
layout_mode = 2
theme_override_colors/font_color = Color(0.54509807, 0.63529414, 0.6862745, 1)
theme_override_font_sizes/font_size = 13
text = "Juros menos crescimento"

[node name="Space" type="Control" parent="Snowball"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="debt_snowball_value" type="Label" parent="Snowball"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.85882354, 0.9019608, 0.9254902, 1)
theme_override_font_sizes/font_size = 13
text = "—"

[node name="Primary" type="HBoxContainer" parent="."]
layout_mode = 2
tooltip_text = "Receita menos gasto sem juros em 12 meses, em pontos do PIB. Superávit reduz a dívida."
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Primary"]
layout_mode = 2
theme_override_colors/font_color = Color(0.54509807, 0.63529414, 0.6862745, 1)
theme_override_font_sizes/font_size = 13
text = "Saldo primário"

[node name="Space" type="Control" parent="Primary"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="debt_primary_value" type="Label" parent="Primary"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.85882354, 0.9019608, 0.9254902, 1)
theme_override_font_sizes/font_size = 13
text = "—"

[node name="Adjustment" type="HBoxContainer" parent="."]
layout_mode = 2
tooltip_text = "Variação da dívida que não vem de juros nem do primário: câmbio, emissão monetária, socorros e calotes."
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Adjustment"]
layout_mode = 2
theme_override_colors/font_color = Color(0.54509807, 0.63529414, 0.6862745, 1)
theme_override_font_sizes/font_size = 13
text = "Câmbio e outros"

[node name="Space" type="Control" parent="Adjustment"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="debt_adjust_value" type="Label" parent="Adjustment"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.85882354, 0.9019608, 0.9254902, 1)
theme_override_font_sizes/font_size = 13
text = "—"
