extends SceneTree
## Ports and airports: data, demand, saturation, war, works, concessions and saving/loading, without the interface.
## Usage: godot --headless --path . --script tests/infra.gd

var failures := 0


func _check(cond: bool, what: String) -> void:
	if cond:
		print("ok: ", what)
	else:
		failures += 1
		print("FAIL: ", what)


func _world(iso := "BRA", seed_value := 11) -> GameWorld:
	var w := GameWorld.new()
	w.setup(seed_value)
	w.leader = Character.random(w.rng)
	w.set_player(w.by_iso[iso], "normal")
	return w


func _months(w: GameWorld, n: int) -> void:
	for i in n:
		var m := w.months_elapsed
		while w.months_elapsed == m:
			w.tick_day()
		w.flush_events()


func _of(w: GameWorld, iso: String, kind := "") -> Array:
	return w.infra.facilities_of(w.by_iso[iso], w).filter(func(f): return kind == "" or f.kind == kind)


func _named(w: GameWorld, iso: String, part: String) -> Dictionary:
	for f: Dictionary in _of(w, iso):
		if String(f.name).contains(part):
			return f
	return {}


func _init() -> void:
	_data()
	_neutral_start()
	_saturation()
	_war()
	_build()
	_concession()
	_ai()
	_save()
	print("RESULT: ", failures, " failures")
	quit(1 if failures > 0 else 0)


func _data() -> void:
	var w := _world()
	var inf := w.infra
	_check(_of(w, "USA", "port").size() >= 8 and _of(w, "USA", "air").size() >= 8, "the USA has several ports and airports")
	_check(_of(w, "CHN", "port").size() >= 8 and _of(w, "CHN", "air").size() >= 8, "China too")
	for part in ["Santos", "Paranaguá", "Itaguaí", "Guarulhos", "Galeão", "Brasília"]:
		_check(not _named(w, "BRA", part).is_empty(), "Brazil has %s" % part)
	_check(_of(w, "CHE", "port").is_empty() and _of(w, "BOL", "port").is_empty(), "Switzerland and Bolivia have no seaport")
	# Outside the file: generated by the economy, with an airport and no port (landlocked).
	var tcd := _of(w, "TCD")
	_check(tcd.size() == 1 and tcd[0].kind == "air" and float(tcd[0].cap) > 0.0, "Chad gets a generated airport: %s" % str(tcd.map(func(f): return f.name)))
	_check(_of(w, "PSE").is_empty(), "empty list in the file = no facility")
	var gru := _named(w, "BRA", "Guarulhos")
	_check(gru.owner == "concession" and is_equal_approx(float(gru.lat), -23.43), "Guarulhos: concession, with coordinates")
	var total := 0
	for c: Country in w.countries:
		if not w.infra.facilities_of(c, w).is_empty():
			total += 1
	_check(total >= w.countries.size() - 2, "almost every country has some facility (%d of %d)" % [total, w.countries.size()])
	_check(inf.saturation(w.by_iso["CHE"], "port") < 0.0, "with no port, port saturation does not exist")


func _neutral_start() -> void:
	var w := _world()
	var ok := true
	for c: Country in w.countries:
		if absf(c.logistics - 1.0) > 0.001:
			ok = false
	_check(ok, "at the start, logistics is neutral in every country")
	_months(w, 2)
	var bra: Country = w.by_iso["BRA"]
	_check(absf(bra.logistics - 1.0) < 0.05, "two months later, still near neutral: %.3f" % bra.logistics)
	var s := w.infra.saturation(bra, "port")
	_check(s > 0.5 and s < 1.1, "the saturation of Brazilian ports is plausible: %.2f" % s)


func _saturation() -> void:
	var w := _world()
	var bra: Country = w.by_iso["BRA"]
	var inf := w.infra
	_months(w, 1)
	var boost0 := bra.sector_boost[Sectors.TRANSPORT]
	var other0 := bra.sector_boost[Sectors.FINANCE]
	# Trade doubles: the ports fill up, logistics worsens and transport loses.
	inf.base_trade[bra.idx] *= 0.5
	inf.base_gdp[bra.idx] *= 0.7
	inf.step_month(w)
	_check(inf.saturation(bra, "port") > 1.2, "with double the trade, the ports go over capacity: %.2f" % inf.saturation(bra, "port"))
	_check(bra.logistics < 0.9, "logistics falls: %.3f" % bra.logistics)
	_check(bra.sector_boost[Sectors.TRANSPORT] < boost0 - 0.02, "o transporte perde produtividade: %.3f" % bra.sector_boost[Sectors.TRANSPORT])
	_check(bra.sector_boost[Sectors.TOURISM] < 0.0, "tourism too, with full airports")
	_check(is_equal_approx(bra.sector_boost[Sectors.FINANCE], other0), "the impulse of other sectors stays untouched")
	var santos := _named(w, "BRA", "Santos")
	_check(float(santos.util) >= 0.99, "Santos operates at the limit: %d%%" % int(float(santos.util) * 100.0))
	# Another system added to transport: our effect is swapped without erasing theirs.
	bra.sector_boost[Sectors.TRANSPORT] += 0.01
	var before := bra.sector_boost[Sectors.TRANSPORT]
	inf.step_month(w)
	_check(absf(bra.sector_boost[Sectors.TRANSPORT] - before) < 0.01, "the sum from another system survives the next step")


func _war() -> void:
	var w := _world()
	var bra: Country = w.by_iso["BRA"]
	var inf := w.infra
	_months(w, 1)
	var s0 := inf.saturation(bra, "port")
	bra.occupied = bra.occ0 + 1.0
	var news := []
	w.news_posted.connect(func(t, _k, _c): news.append(t))
	inf.step_month(w)
	w.flush_events()
	var closed := _of(w, "BRA").filter(func(f): return f.closed).size()
	_check(closed == _of(w, "BRA").size(), "with the whole country occupied, everything closes (%d)" % closed)
	_check(inf.saturation(bra, "port") >= 2.0 and bra.logistics < 0.8, "without ports, trade stalls: logistics %.2f" % bra.logistics)
	_check(news.any(func(t): return String(t).contains("fecha")), "the closure becomes news")
	bra.occupied = bra.occ0
	inf.step_month(w)
	_check(_of(w, "BRA").all(func(f): return not f.closed), "desocupado, tudo reabre")
	_check(absf(inf.saturation(bra, "port") - s0) < 0.15, "and saturation returns to normal")
	# War damage: lower capacity, repair gradually.
	var santos := _named(w, "BRA", "Santos")
	santos.cond = 0.5
	inf._rebuild_index(w)
	var spend0 := bra.extra_spend_bucket
	inf.step_month(w)
	_check(float(santos.cond) > 0.5 and float(santos.cond) < 1.0, "outside war, the port is gradually repaired: %.2f" % float(santos.cond))
	_check(bra.extra_spend_bucket > spend0, "e o Estado paga o reparo")


func _build() -> void:
	var w := _world()
	var bra: Country = w.by_iso["BRA"]
	var inf := w.infra
	var santos := _named(w, "BRA", "Santos")
	var cap0 := float(santos.cap)
	var q := inf.expansion_quote(santos, bra, 0.5)
	_check(float(q.cost) > 0.5 and float(q.cost) < 10.0 and int(q.months) >= 24, "expanding Santos by 50%%: US$ %.1f bn, %d months" % [q.cost, q.months])
	var r := inf.start_expansion(w, bra, int(santos.id), 0.5)
	_check(r.ok, "the expansion starts:" + r.msg)
	_check(not inf.start_expansion(w, bra, int(santos.id), 0.5).ok, "two projects cannot be opened at the same port")
	_check(not inf.start_expansion(w, bra, int(_named(w, "BRA", "Guarulhos").id), 0.5).ok, "a concession is not expanded by the government")
	var near := _named(w, "BRA", "Brasília")
	var r2 := inf.start_new(w, bra, "air", int(near.id), 1)
	_check(r2.ok, "a new airport starts:" + r2.msg)
	_check(not inf.start_new(w, w.by_iso["CHE"], "port", int(_of(w, "CHE")[0].id), 0).ok, "Switzerland does not build a port")
	_check(inf.projects_of(bra).size() == 2, "the country has two projects")
	var spent := 0.0
	var news := []
	w.news_posted.connect(func(t, _k, _c): news.append(t))
	for i in 70:
		bra.extra_spend_bucket = 0.0
		inf.step_month(w)
		spent += bra.extra_spend_bucket
	w.flush_events()
	_check(is_equal_approx(float(santos.cap), cap0 * 1.5), "Santos gains 50%% capacity: %.2f" % float(santos.cap))
	_check(spent > float(q.cost) * 0.99, "the cost comes out month by month from the Treasury: US$ %.1f bn" % spent)
	_check(not _named(w, "BRA", "Novo aeroporto de Brasília").is_empty(), "the new airport starts operating")
	_check(news.any(func(t): return String(t).contains("Concluída a ampliação")) and news.any(func(t): return String(t).begins_with("Inaugurado")), "completions become news")
	_check(inf.projects_of(bra).filter(func(p): return p.public).is_empty(), "public works leave the list")


func _concession() -> void:
	var w := _world()
	var bra: Country = w.by_iso["BRA"]
	var inf := w.infra
	_months(w, 1)
	var sd := _named(w, "BRA", "Santos Dumont")
	var value := inf.concession_value(sd, bra)
	var rev0 := bra.extra_rev_bucket
	var r := inf.concede(w, bra, int(sd.id))
	_check(r.ok and sd.owner == "concession", "Santos Dumont is conceded:" + r.msg)
	_check(is_equal_approx(bra.extra_rev_bucket - rev0, value) and value > 0.2, "the one-off revenue goes into the Treasury: US$ %.2f bn" % value)
	_check(not inf.concede(w, bra, int(sd.id)).ok, "it cannot be conceded twice")
	_check(not inf.concede(w, bra, int(_named(w, "BRA", "Tubarão").id)).ok, "a private asset cannot be conceded")


func _ai() -> void:
	var w := _world()
	var inf := w.infra
	# All countries with double the trade: the AI reacts with works, the player does not.
	for c: Country in w.countries:
		inf.base_trade[c.idx] *= 0.45
	for i in 12:
		inf.step_month(w)
	var builders := {}
	for p: Dictionary in inf.projects:
		if p.public and p.kind == "port":
			builders[int(p.payer)] = true
	_check(builders.size() >= 20, "saturated AI countries invest in ports: %d" % builders.size())
	_check(not builders.has(w.player.idx), "the player's country does not get public works on its own")
	_check(inf.projects.any(func(p): return not p.public), "private operators also expand")


func _save() -> void:
	var w := _world()
	var bra: Country = w.by_iso["BRA"]
	_months(w, 2)
	w.infra.start_expansion(w, bra, int(_named(w, "BRA", "Santos").id), 0.25)
	w.infra.concede(w, bra, int(_named(w, "BRA", "Santos Dumont").id))
	var back := GameWorld.new()
	back.load_dict(bytes_to_var(var_to_bytes(w.to_dict())))
	var b2: Country = back.by_iso["BRA"]
	_check(back.infra.facilities.size() == w.infra.facilities.size(), "the facilities come back from the save")
	_check(back.infra.projects_of(b2).size() == w.infra.projects_of(bra).size(), "the projects too")
	_check(_named(back, "BRA", "Santos Dumont").owner == "concession", "and the concession")
	_check(is_equal_approx(back.infra.saturation(b2, "port"), w.infra.saturation(bra, "port")), "saturation is the same")
	w.infra.step_month(w)
	back.infra.step_month(back)
	_check(is_equal_approx(b2.logistics, bra.logistics), "and the simulation continues the same after loading")
